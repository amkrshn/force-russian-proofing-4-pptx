# Public/internal DNS name of the service
SERVER_NAME=pptx-proofing.internal.example

# Browser origins allowed to call the API directly.
# Prefer same-origin proxying through the surrounding third-party service when possible.
CORS_ORIGINS=https://pptx-proofing.internal.example,https://host-service.internal.example

# Host header values accepted by FastAPI TrustedHostMiddleware.
ALLOWED_HOSTS=pptx-proofing.internal.example,app,localhost,127.0.0.1

# Upload and processing limits
MAX_UPLOAD_BYTES=104857600
NGINX_CLIENT_MAX_BODY_SIZE=110m
MAX_ZIP_ENTRIES=10000
MAX_UNCOMPRESSED_BYTES=524288000
MAX_COMPRESSION_RATIO=250
MAX_CONCURRENT_JOBS=2
JOB_TTL_SECONDS=3600
TMPFS_SIZE=768m

# Production FastAPI docs are disabled by default.
ENABLE_DOCS=false

# Optional host port overrides
HTTP_PORT=80
HTTPS_PORT=443

# Optional prebuilt image instead of local build
APP_IMAGE=force-russian-proofing4pptx:local
