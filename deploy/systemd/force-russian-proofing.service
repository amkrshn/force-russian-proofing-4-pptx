[Unit]
Description=Force RussianProofing4PPTX Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/force-russian-proofing-4-pptx
ExecStart=/usr/bin/docker compose --env-file deploy/.env.prod -f docker-compose.prod.yml up -d --build
ExecStop=/usr/bin/docker compose --env-file deploy/.env.prod -f docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
